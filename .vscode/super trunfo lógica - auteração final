#include <stdio.h>
#include <string.h>

// Estrutura representando uma carta de país
typedef struct {
    char nome[30];
    float populacao;          // milhões
    float area;               // km²
    float pib;                // bilhões
    float densidade;          // hab/km²
} Carta;

// Função auxiliar para exibir uma carta
void exibirCarta(Carta c) {
    printf("\n=== %s ===", c.nome);
    printf("\nPopulação: %.2f milhões", c.populacao);
    printf("\nÁrea: %.2f km²", c.area);
    printf("\nPIB: %.2f bilhões", c.pib);
    printf("\nDensidade Demográfica: %.2f hab/km²\n", c.densidade);
}

// comparar dois atributos
int compararAtributo(Carta c1, Carta c2, int atributo) {
    switch (atributo) {
        case 1: // População
            return (c1.populacao > c2.populacao) ? 1 : (c1.populacao < c2.populacao ? -1 : 0);
        case 2: // Área
            return (c1.area > c2.area) ? 1 : (c1.area < c2.area ? -1 : 0);
        case 3: // PIB
            return (c1.pib > c2.pib) ? 1 : (c1.pib < c2.pib ? -1 : 0);
        case 4: // Densidade (menor vence)
            return (c1.densidade < c2.densidade) ? 1 : (c1.densidade > c2.densidade ? -1 : 0);
        default:
            return 0;
    }
}

// obter o valor de um atributo específico
float valorAtributo(Carta c, int atributo) {
    switch (atributo) {
        case 1: return c.populacao;
        case 2: return c.area;
        case 3: return c.pib;
        case 4: return c.densidade;
        default: return 0;
    }
}

// exibir o nome do atributo
const char* nomeAtributo(int atributo) {
    switch (atributo) {
        case 1: return "População";
        case 2: return "Área";
        case 3: return "PIB";
        case 4: return "Densidade Demográfica";
        default: return "Desconhecido";
    }
}

int main() {
    // Cartas pré-cadastradas
    Carta Porto_Alegre = {"Porto Alegre", 11300000.0, 281730.2, 706820.0, 40.15};
    Carta Florianópolis  = {"Florianópolis", 8058441.0, 95730.69, 504600.0, 84.17};

    int atributo1, atributo2;
    float soma1 = 0, soma2 = 0;
    int resultado1, resultado2, resultadoFinal;

    printf("=== SUPER TRUNFO - Comparação de Estados ===\n");
    printf("\nCarta 1:");
    exibirCarta(Porto_Alegre);
    printf("\nCarta 2:");
    exibirCarta(Florianópolis);

    // Escolha do primeiro atributo
    printf("\nEscolha o PRIMEIRO atributo para comparar:\n");
    printf("1 - População\n2 - Área\n3 - PIB\n4 - Densidade Demográfica\n> ");
    scanf("%d", &atributo1);

    // Menu dinâmico: o segundo atributo não pode ser o mesmo
    printf("\nEscolha o SEGUNDO atributo (diferente do primeiro):\n");
    switch (atributo1) {
        case 1:
            printf("2 - Área\n3 - PIB\n4 - Densidade Demográfica\n> ");
            break;
        case 2:
            printf("1 - População\n3 - PIB\n4 - Densidade Demográfica\n> ");
            break;
        case 3:
            printf("1 - População\n2 - Área\n4 - Densidade Demográfica\n> ");
            break;
        case 4:
            printf("1 - População\n2 - Área\n3 - PIB\n> ");
            break;
        default:
            printf("Opção inválida! Encerrando...\n");
            return 0;
    }

    scanf("%d", &atributo2);

    // Verifica se o jogador escolheu dois atributos válidos e diferentes
    if (atributo2 == atributo1 || atributo2 < 1 || atributo2 > 4) {
        printf("\nErro: O segundo atributo deve ser diferente e válido!\n");
        return 0;
    }

    // Comparação de cada atributo
    resultado1 = compararAtributo(Porto_Alegre, Florianópolis, atributo1);
    resultado2 = compararAtributo(Porto_Alegre, Florianópolis, atributo2);

    // Soma dos valores dos dois atributos
    soma1 = valorAtributo(Porto_Alegre, atributo1) + valorAtributo(Porto_Alegre, atributo2);
    soma2 = valorAtributo(Florianópolis, atributo1) + valorAtributo(Florianópolis, atributo2);

    // Exibição dos resultados detalhados
    printf("\n=== RESULTADO DA COMPARAÇÃO ===\n");
    printf("\nAtributo 1: %s\n", nomeAtributo(atributo1));
    printf("Porto Alegre: %.2f | Florianópolis: %.2f\n", valorAtributo(Porto_Alegre, atributo1), valorAtributo(Florianópolis, atributo1));
    printf("Resultado: %s vence esse atributo!\n",
           (resultado1 == 1 ? "Porto Alegre" : (resultado1 == -1 ? "Florianópolis" : "Empate")));

    printf("\nAtributo 2: %s\n", nomeAtributo(atributo2));
    printf("Porto Alegre: %.2f | Florianópolis: %.2f\n", valorAtributo(Porto_Alegre, atributo2), valorAtributo(Florianópolis, atributo2));
    printf("Resultado: %s vence esse atributo!\n",
           (resultado2 == 1 ? "Porto Alegre" : (resultado2 == -1 ? "Florianópolis" : "Empate")));

    printf("\nSoma dos atributos:\n");
    printf("Porto Alegre: %.2f | Florianópolis: %.2f\n", soma1, soma2);

    // Determinação final com operador ternário
    resultadoFinal = (soma1 > soma2) ? 1 : (soma1 < soma2 ? -1 : 0);

    printf("\n=== RESULTADO FINAL ===\n");
    if (resultadoFinal == 1)
        printf("Porto Alegre vence a rodada!\n");
    else if (resultadoFinal == -1)
        printf("Florianópolis vence a rodada!\n");
    else
        printf("Empate!\n");

    return 0;
}

